# Database Connection
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/injester

# Super Admin / Developer Platform Credentials (bootstrapped securely on first run)
SUPERADMIN_EMAIL=admin@injester.platform
SUPERADMIN_INITIAL_PASSWORD=ChangeMeDeveloperPlatform2026!

# Active LLM BYOAI Configuration (Configurable by Dev Admin)
OPENAI_BASE_URL=https://lightning.ai/api/v1/
OPENAI_API_KEY=your_lightning_or_openrouter_key
MODEL_NAME=google/gemini-2.5-flash-lite-preview-06-17

# Provider Specific Keys (accessible for quick-switching by Dev Admin)
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://lightning.ai/api/v1/
LIGHTNING_MODEL=google/gemini-2.5-flash-lite-preview-06-17

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free

# Local Storage Directory for Files and FAISS vector indices
STORAGE_DIR=./storage

# Embedding Model (SentenceTransformers local model)
EMBEDDING_MODEL=all-MiniLM-L6-v2
