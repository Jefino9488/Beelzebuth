# Database Connection
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/injester

# Super Admin / Developer Platform Credentials (bootstrapped securely on first run)
SUPERADMIN_EMAIL=admin@injester.platform
SUPERADMIN_INITIAL_PASSWORD=ChangeMeDeveloperPlatform2026!

# Active LLM BYOAI Configuration (Configurable by Dev Admin)
OPENAI_BASE_URL=https://lightning.ai/api/v1/
OPENAI_API_KEY=your_lightning_or_openrouter_key
MODEL_NAME=google/gemini-2.5-flash-lite-preview-06-17

# Provider Specific Keys (accessible for quick-switching by Dev Admin)
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://lightning.ai/api/v1/
LIGHTNING_MODEL=google/gemini-2.5-flash-lite-preview-06-17

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free

# System-1 Grounding Verifier (BYOAI)
# SYSTEM1_PROVIDER selects the verification engine:
#   openjev  -> local OpenJev NLI cross-encoder (offline, default)
#   laya    -> local Laya checkpoint (offline)
#   jev     -> TypeSafe Jev System-1 API (BYOAI: base URL / API key / model)
#   openai  -> any OpenAI-compatible System-1 endpoint (BYOAI: base URL / API key / model)
SYSTEM1_PROVIDER=openjev
# API wire protocol for API-based verifiers: typesafe | openai_compatible
SYSTEM1_API_MODE=typesafe
# Leave empty to fall back to the legacy TYPESAFE_* values (typesafe mode)
# or to the main LLM BYOAI configuration (openai_compatible mode).
SYSTEM1_API_BASE_URL=
SYSTEM1_API_KEY=
SYSTEM1_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# System-1 Validation Policy Thresholds
SYSTEM1_POLICY_ACTOR_THRESHOLD=0.50
SYSTEM1_POLICY_ACTION_THRESHOLD=0.50
SYSTEM1_POLICY_OUTCOME_THRESHOLD=0.40
SYSTEM1_POLICY_UNCERTAIN_THRESHOLD=0.35

# Local Storage Directory for Files and FAISS vector indices
STORAGE_DIR=./storage

# Embedding Model (SentenceTransformers local model)
EMBEDDING_MODEL=all-MiniLM-L6-v2
